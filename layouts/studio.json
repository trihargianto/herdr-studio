{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    15
  ],
  "background": "canvas",
  "terminal_padding": [
    12,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 232
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 44
          },
          "window_drag": true,
          "content": {
            "mod": "studio-workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "px": 240
              },
              "min": 90,
              "content": {
                "mod": "studio-spaces"
              },
              "max": 380
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 2
              },
              "min": 90,
              "content": {
                "mod": "studio-dashboard"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "studio-workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 44
          },
          "window_drag": true,
          "content": {
            "mod": "studio-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 12,
          "gap": 12,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 10,
                  "radius": 8,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "studio-pane"
                    },
                    "height": 28,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 320
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "tasks",
                  "children": [
                    {
                      "id": "projects",
                      "type": "block",
                      "content": {
                        "mod": "studio-projects"
                      }
                    },
                    {
                      "id": "panes",
                      "type": "block",
                      "content": {
                        "mod": "studio-panes"
                      }
                    },
                    {
                      "id": "inbox",
                      "type": "block",
                      "content": {
                        "mod": "studio-inbox"
                      }
                    },
                    {
                      "id": "send",
                      "type": "block",
                      "content": {
                        "mod": "studio-send"
                      }
                    },
                    {
                      "id": "mrs",
                      "type": "block",
                      "content": {
                        "mod": "studio-mrs"
                      }
                    },
                    {
                      "id": "tasks",
                      "type": "block",
                      "content": {
                        "mod": "studio-tasks"
                      }
                    },
                    {
                      "id": "ports",
                      "type": "block",
                      "content": {
                        "mod": "studio-ports"
                      }
                    },
                    {
                      "id": "usage",
                      "type": "block",
                      "content": {
                        "mod": "studio-usage"
                      }
                    },
                    {
                      "id": "review",
                      "type": "block",
                      "content": {
                        "mod": "studio-review"
                      }
                    },
                    {
                      "id": "automations",
                      "type": "block",
                      "content": {
                        "mod": "studio-automations"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "studio-workspace-status"
          }
        }
      ]
    }
  ],
  "cloned_from": {
    "name": "main",
    "version": "0.1.14"
  },
  "preview": "layouts/studio.svg"
}
